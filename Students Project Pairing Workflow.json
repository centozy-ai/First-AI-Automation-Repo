    {
      "parameters": {
        "jsCode": "// Retrieve all incoming student records from the Google Sheets Read Rows node\nconst inputItems = $input.all();\n\n// Filter and map incoming items to ensure we only process valid, pending student entries\nconst students = inputItems\n  .map(item => item.json)\n  .filter(student => student[\"Full Name\"] && student[\"Email Address\"])\n  .map(student => ({\n    rowNumber: student[\"row_number\"],\n    name: student[\"Full Name\"],\n    email: student[\"Email Address\"],\n    cohort: student[\"Cohort ID\"] || \"Default Cohort\"\n  }));\n\n// Return early if no pending students are found\nif (students.length === 0) {\n  return [];\n}\n\n// Available industry bank for project assignment\nconst industries = [\n  \"Healthcare\", \"E-Commerce\", \"Finance & Banking\", \n  \"Real Estate\", \"Logistics & Supply Chain\", \"EdTech\", \n  \"Hospitality & Tourism\", \"Marketing & Advertising\"\n];\n\n// Fisher-Yates Shuffle algorithm for true random pairing\nfunction shuffle(array) {\n  let currentIndex = array.length, randomIndex;\n  while (currentIndex !== 0) {\n    randomIndex = Math.floor(Math.random() * currentIndex);\n    currentIndex--;\n    [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];\n  }\n  return array;\n}\n\nconst shuffledStudents = shuffle([...students]);\nconst shuffledIndustries = shuffle([...industries]);\n\nconst pairs = [];\nlet industryIndex = 0;\n\n// Group students into pairs of 2 (or a group of 3 if odd count)\nfor (let i = 0; i < shuffledStudents.length; i += 2) {\n  const currentIndustry = shuffledIndustries[industryIndex % shuffledIndustries.length];\n  industryIndex++;\n\n  if (i === shuffledStudents.length - 1) {\n    // Edge case: Odd number of students -> attach remaining student to the last group\n    if (pairs.length > 0) {\n      pairs[pairs.length - 1].students.push(shuffledStudents[i]);\n    } else {\n      pairs.push({\n        pairId: 1,\n        industry: currentIndustry,\n        students: [shuffledStudents[i]]\n      });\n    }\n  } else {\n    pairs.push({\n      pairId: pairs.length + 1,\n      industry: currentIndustry,\n      students: [shuffledStudents[i], shuffledStudents[i + 1]]\n    });\n  }\n}\n\n// Unroll pairs into individual student output objects formatted for Google Sheets update & Email nodes\nconst output = [];\n\npairs.forEach(pair => {\n  pair.students.forEach((student, index) => {\n    // Generate partner details excluding the current student\n    const partnerList = pair.students\n      .filter((_, idx) => idx !== index)\n      .map(s => `${s.name} (${s.email})`)\n      .join(\", \");\n\n    output.push({\n      json: {\n        // Matches Google Sheets row update primary key\n        row_number: student.rowNumber,\n        \n        // Mapped original fields\n        \"Full Name\": student.name,\n        \"Email Address\": student.email,\n        \"Cohort ID\": student.cohort,\n        \n        // Derived assignment outputs\n        \"Status\": \"Paired & Emailed\",\n        \"Assigned Industry\": pair.industry,\n        \"Partner Details\": partnerList || \"No partner (solo group)\",\n        \"Group ID\": `Group-${pair.pairId}`\n      }\n    });\n  });\n});\n\nreturn output;"
      },
