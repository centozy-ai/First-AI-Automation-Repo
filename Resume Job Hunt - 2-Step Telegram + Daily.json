    {
      "parameters": {
        "jsCode": "let data = null;\n\n// Try Path 1 first (Telegram on-demand)\ntry {\n  if ($('Set Resume + Role Data').isExecuted) {\n    data = $('Set Resume + Role Data').item.json;\n  }\n} catch (e) {}\n\n// If Path 1 was not used, try Path 2 (Schedule)\nif (!data) {\n  try {\n    if ($('Set Data (Scheduled)').isExecuted) {\n      data = $('Set Data (Scheduled)').item.json;\n    }\n  } catch (e) {}\n}\n\n// Final fallback – use whatever is currently in the input\nif (!data) {\n  data = $input.first().json;\n}\n\nconst role = (data.jobRole || '').trim();\nconst resumeText = data.resumeText || '';\nconst telegramChatId = data.telegramChatId || '';\nconst triggerSource = data.triggerSource || 'unknown';\n\nif (!role) {\n  throw new Error('No jobRole found in either path');\n}\n\nreturn [{\n  json: {\n    jobRole: role,\n    resumeText: resumeText,\n    telegramChatId: telegramChatId,\n    triggerSource: triggerSource,\n    apifyQuery: role,\n    apifyRemote: 'remote',\n    apifyMaxRows: 12          // keep it low for free tier\n  }\n}];"
      },
