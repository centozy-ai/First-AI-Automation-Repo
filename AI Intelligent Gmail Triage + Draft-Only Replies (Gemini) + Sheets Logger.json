    {
      "parameters": {
        "promptType": "define",
        "text": "=From: {{ $json.from }}\nSubject: {{ $json.subject }}\nBody:\n{{ $json.body }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert Gmail email triage specialist. Classify the email into EXACTLY ONE of these categories:\n\n- Primary: Real human-to-human messages that usually need attention or a reply (work, personal conversations, questions, meetings, important requests).\n- Social: Notifications from social networks (LinkedIn, Facebook, X/Twitter, Instagram, etc.).\n- Promotions: Marketing, newsletters, deals, offers, sales, product announcements.\n- Updates: Automated transactional messages (receipts, order confirmations, shipping updates, statements, password resets, calendar invites, system alerts).\n- Spam: Clearly unwanted, phishing, scam, or pure junk.\n\nRules:\n1. Return ONLY valid JSON. No markdown, no extra text, no code fences.\n2. Be conservative with Primary — only genuine human communication.\n3. Prefer Updates over Promotions for transactional content.\n4. Use Spam only when clearly malicious or pure bulk junk.\n\nRequired JSON schema:\n{\n  \"category\": \"Primary|Social|Promotions|Updates|Spam\",\n  \"confidence\": 0.0-1.0,\n  \"summary\": \"One concise sentence summary\",\n  \"needs_reply\": true/false,\n  \"suggested_reply_tone\": \"professional|friendly|neutral|none\",\n  \"reasoning\": \"Very brief reason\"\n}"
            }
          ]
        }
      },
      "id": "ccabc0d9-fce0-4958-b665-675f2cad27ba",
      "name": "Gemini Classification",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        592,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet text = input.text || input.output || input.content || JSON.stringify(input);\n\ntext = text.replace(/```json\\n?/gi, '').replace(/```\\n?/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(text);\n} catch (e) {\n  parsed = {\n    category: \"Primary\",\n    confidence: 0.4,\n    summary: \"Parse failed – manual review needed\",\n    needs_reply: true,\n    suggested_reply_tone: \"professional\",\n    reasoning: \"JSON parse error\"\n  };\n}\n\nconst valid = [\"Primary\", \"Social\", \"Promotions\", \"Updates\", \"Spam\"];\nif (!valid.includes(parsed.category)) {\n  parsed.category = \"Primary\";\n  parsed.confidence = Math.min(parsed.confidence || 0.5, 0.5);\n}\n\nreturn [{\n  json: {\n    ...$('Prepare Email Context').item.json,\n    ...parsed\n  }\n}];"
      },
      "id": "9b0bb7e7-ca84-4ec1-832e-d68c41931fc0",
      "name": "Parse & Validate JSON",
